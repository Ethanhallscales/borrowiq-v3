# ── GoHighLevel ──────────────────────────────────────────────────────────
# Inbound webhook both funnels post leads to. They are told apart in GHL by
# the `source` field: "borrowiq-start" from /, "borrowiq" from /v1.
GHL_WEBHOOK_URL=

# ── Meta ─────────────────────────────────────────────────────────────────
# Pixel id. Used by the browser pixel AND by the server-side Conversions
# API, which must report to the same pixel for dedup to work.
NEXT_PUBLIC_META_PIXEL_ID=

# Conversions API access token. SERVER ONLY — never prefix this with
# NEXT_PUBLIC_, it would be shipped to the browser.
# Events Manager → your pixel → Settings → Generate access token.
META_CAPI_ACCESS_TOKEN=

# OPTIONAL. When set, server events land in Events Manager → Test Events
# instead of counting as live conversions. MUST be unset in production or
# the ad set sees no conversions at all.
META_TEST_EVENT_CODE=

# ── Booking ──────────────────────────────────────────────────────────────
# Off-site booking link. Bookings are not tracked in this app.
NEXT_PUBLIC_CALENDLY_URL=
